{
  "version": "1.0.0",
  "description": "SharePoint Lists Schema for OOOOO Calendar System",
  "lists": [
    {
      "listName": "StaffSchedule",
      "description": "Main schedule and time-off request data",
      "templateType": "GenericList",
      "enableVersioning": true,
      "enableContentTypes": false,
      "columns": [
        {
          "name": "Title",
          "displayName": "Request ID",
          "type": "Text",
          "required": true,
          "description": "Auto-generated unique identifier (e.g., REQ-20250114-001)"
        },
        {
          "name": "EmployeeName",
          "displayName": "Employee Name",
          "type": "User",
          "required": true,
          "description": "Link to Azure AD user (Person or Group field)"
        },
        {
          "name": "EmployeeEmail",
          "displayName": "Employee Email",
          "type": "Text",
          "required": true,
          "description": "Employee email address (auto-populated from user field)"
        },
        {
          "name": "ScheduleDate",
          "displayName": "Date",
          "type": "DateTime",
          "format": "DateOnly",
          "required": true,
          "description": "Date for the schedule entry"
        },
        {
          "name": "Status",
          "displayName": "Status",
          "type": "Choice",
          "required": true,
          "choices": [
            "Onsite",
            "Offsite",
            "OOO-Pending",
            "OOO-Approved",
            "OOO-Rejected"
          ],
          "default": "Onsite",
          "description": "Current status of the schedule entry"
        },
        {
          "name": "RequestType",
          "displayName": "Request Type",
          "type": "Choice",
          "required": true,
          "choices": [
            "Regular Schedule",
            "Vacation",
            "Sick Leave",
            "Personal Day",
            "Other"
          ],
          "default": "Regular Schedule",
          "description": "Type of request or schedule entry"
        },
        {
          "name": "StartDate",
          "displayName": "Start Date",
          "type": "DateTime",
          "format": "DateOnly",
          "required": false,
          "description": "Start date for multi-day OOO requests"
        },
        {
          "name": "EndDate",
          "displayName": "End Date",
          "type": "DateTime",
          "format": "DateOnly",
          "required": false,
          "description": "End date for multi-day OOO requests"
        },
        {
          "name": "Comments",
          "displayName": "Comments/Notes",
          "type": "Note",
          "required": false,
          "richText": false,
          "description": "Optional comments from employee"
        },
        {
          "name": "SubmissionDateTime",
          "displayName": "Submission Date/Time",
          "type": "DateTime",
          "format": "DateTime",
          "required": true,
          "description": "When the request was submitted"
        },
        {
          "name": "ApprovedBy",
          "displayName": "Approved By",
          "type": "User",
          "required": false,
          "description": "Manager who approved/rejected (Person or Group field)"
        },
        {
          "name": "ApprovalDateTime",
          "displayName": "Approval Date/Time",
          "type": "DateTime",
          "format": "DateTime",
          "required": false,
          "description": "When approval/rejection occurred"
        },
        {
          "name": "ManagerComments",
          "displayName": "Manager Comments",
          "type": "Note",
          "required": false,
          "richText": false,
          "description": "Manager's comments on approval/rejection"
        },
        {
          "name": "ApprovalRequestId",
          "displayName": "Approval Request ID",
          "type": "Text",
          "required": false,
          "description": "Teams approval action request ID for tracking"
        },
        {
          "name": "CalendarEventId",
          "displayName": "Calendar Event ID",
          "type": "Text",
          "required": false,
          "description": "Outlook calendar event ID for synchronization"
        },
        {
          "name": "IsActive",
          "displayName": "Is Active",
          "type": "Boolean",
          "required": true,
          "default": true,
          "description": "Whether this entry is active (not cancelled)"
        }
      ],
      "views": [
        {
          "name": "All Items",
          "type": "Default",
          "fields": ["Title", "EmployeeName", "ScheduleDate", "Status", "RequestType", "SubmissionDateTime"]
        },
        {
          "name": "Pending Approvals",
          "type": "Custom",
          "filter": "Status eq 'OOO-Pending'",
          "fields": ["Title", "EmployeeName", "StartDate", "EndDate", "RequestType", "SubmissionDateTime"]
        },
        {
          "name": "My Requests",
          "type": "Custom",
          "filter": "[Me]",
          "fields": ["Title", "ScheduleDate", "Status", "RequestType", "SubmissionDateTime", "ApprovalDateTime"]
        },
        {
          "name": "Approved Time Off",
          "type": "Custom",
          "filter": "Status eq 'OOO-Approved'",
          "fields": ["EmployeeName", "StartDate", "EndDate", "RequestType", "ApprovedBy"]
        }
      ]
    },
    {
      "listName": "ApprovalHistory",
      "description": "Complete audit trail of all approval actions",
      "templateType": "GenericList",
      "enableVersioning": true,
      "enableContentTypes": false,
      "columns": [
        {
          "name": "Title",
          "displayName": "History ID",
          "type": "Text",
          "required": true,
          "description": "Unique identifier for this history record"
        },
        {
          "name": "RequestID",
          "displayName": "Request ID",
          "type": "Lookup",
          "lookupList": "StaffSchedule",
          "lookupField": "Title",
          "required": true,
          "description": "Link to the original schedule request"
        },
        {
          "name": "EmployeeName",
          "displayName": "Employee Name",
          "type": "User",
          "required": true,
          "description": "Employee who made the request"
        },
        {
          "name": "RequestStartDate",
          "displayName": "Request Start Date",
          "type": "DateTime",
          "format": "DateOnly",
          "required": true,
          "description": "Start date of the request"
        },
        {
          "name": "RequestEndDate",
          "displayName": "Request End Date",
          "type": "DateTime",
          "format": "DateOnly",
          "required": false,
          "description": "End date of the request (for multi-day)"
        },
        {
          "name": "RequestType",
          "displayName": "Request Type",
          "type": "Choice",
          "required": true,
          "choices": [
            "Vacation",
            "Sick Leave",
            "Personal Day",
            "Other"
          ],
          "description": "Type of time-off request"
        },
        {
          "name": "Action",
          "displayName": "Action",
          "type": "Choice",
          "required": true,
          "choices": [
            "Submitted",
            "Approved",
            "Rejected",
            "Cancelled",
            "Modified"
          ],
          "description": "Action taken on the request"
        },
        {
          "name": "ActionDateTime",
          "displayName": "Action Date/Time",
          "type": "DateTime",
          "format": "DateTime",
          "required": true,
          "description": "When the action occurred"
        },
        {
          "name": "ActorName",
          "displayName": "Actor Name",
          "type": "User",
          "required": true,
          "description": "Person who performed the action"
        },
        {
          "name": "ActorComments",
          "displayName": "Comments",
          "type": "Note",
          "required": false,
          "richText": false,
          "description": "Comments from the person performing the action"
        },
        {
          "name": "OriginalRequestDetails",
          "displayName": "Original Request Details",
          "type": "Note",
          "required": false,
          "richText": false,
          "description": "JSON snapshot of original request data"
        },
        {
          "name": "ApprovalDuration",
          "displayName": "Approval Duration (hours)",
          "type": "Number",
          "required": false,
          "decimals": 2,
          "description": "Time from submission to approval/rejection"
        }
      ],
      "views": [
        {
          "name": "All History",
          "type": "Default",
          "fields": ["Title", "RequestID", "EmployeeName", "Action", "ActionDateTime", "ActorName"]
        },
        {
          "name": "Recent Approvals",
          "type": "Custom",
          "filter": "Action eq 'Approved'",
          "sort": "ActionDateTime desc",
          "fields": ["RequestID", "EmployeeName", "RequestStartDate", "RequestEndDate", "ActorName", "ActionDateTime"]
        }
      ]
    },
    {
      "listName": "UserProfiles",
      "description": "Extended user profile information and manager relationships",
      "templateType": "GenericList",
      "enableVersioning": true,
      "enableContentTypes": false,
      "columns": [
        {
          "name": "Title",
          "displayName": "User Email",
          "type": "Text",
          "required": true,
          "description": "User's email address (unique identifier)"
        },
        {
          "name": "UserAccount",
          "displayName": "User Account",
          "type": "User",
          "required": true,
          "description": "Link to Azure AD user account"
        },
        {
          "name": "DisplayName",
          "displayName": "Display Name",
          "type": "Text",
          "required": true,
          "description": "User's full name"
        },
        {
          "name": "Manager",
          "displayName": "Manager",
          "type": "User",
          "required": true,
          "description": "User's direct manager"
        },
        {
          "name": "ManagerEmail",
          "displayName": "Manager Email",
          "type": "Text",
          "required": true,
          "description": "Manager's email address"
        },
        {
          "name": "Department",
          "displayName": "Department",
          "type": "Text",
          "required": false,
          "description": "Department or team"
        },
        {
          "name": "IsManager",
          "displayName": "Is Manager",
          "type": "Boolean",
          "required": true,
          "default": false,
          "description": "Whether this user has manager privileges"
        },
        {
          "name": "IsActive",
          "displayName": "Is Active",
          "type": "Boolean",
          "required": true,
          "default": true,
          "description": "Whether user is active in the system"
        },
        {
          "name": "NotificationPreferences",
          "displayName": "Notification Preferences",
          "type": "Choice",
          "required": true,
          "choices": [
            "Teams Only",
            "Email Only",
            "Both",
            "None"
          ],
          "default": "Both",
          "description": "User's notification preferences"
        },
        {
          "name": "TimeZone",
          "displayName": "Time Zone",
          "type": "Choice",
          "required": false,
          "choices": [
            "Eastern",
            "Central",
            "Mountain",
            "Pacific"
          ],
          "default": "Central",
          "description": "User's time zone (for MN IT Services)"
        }
      ],
      "views": [
        {
          "name": "All Users",
          "type": "Default",
          "fields": ["DisplayName", "UserAccount", "Manager", "Department", "IsManager", "IsActive"]
        },
        {
          "name": "Managers",
          "type": "Custom",
          "filter": "IsManager eq true",
          "fields": ["DisplayName", "UserAccount", "Department"]
        }
      ]
    },
    {
      "listName": "SystemSettings",
      "description": "Application configuration and settings",
      "templateType": "GenericList",
      "enableVersioning": true,
      "enableContentTypes": false,
      "columns": [
        {
          "name": "Title",
          "displayName": "Setting Name",
          "type": "Text",
          "required": true,
          "description": "Unique setting identifier"
        },
        {
          "name": "SettingValue",
          "displayName": "Setting Value",
          "type": "Text",
          "required": true,
          "description": "Value of the setting"
        },
        {
          "name": "SettingType",
          "displayName": "Setting Type",
          "type": "Choice",
          "required": true,
          "choices": [
            "Text",
            "Number",
            "Boolean",
            "JSON"
          ],
          "description": "Data type of the setting"
        },
        {
          "name": "Description",
          "displayName": "Description",
          "type": "Note",
          "required": false,
          "richText": false,
          "description": "Description of what this setting controls"
        },
        {
          "name": "Category",
          "displayName": "Category",
          "type": "Choice",
          "required": true,
          "choices": [
            "General",
            "Approval",
            "Notification",
            "Calendar",
            "Security"
          ],
          "description": "Setting category"
        },
        {
          "name": "IsEditable",
          "displayName": "Is Editable",
          "type": "Boolean",
          "required": true,
          "default": true,
          "description": "Whether this setting can be changed by admins"
        }
      ],
      "defaultSettings": [
        {
          "Title": "MinimumAdvanceNoticeDays",
          "SettingValue": "3",
          "SettingType": "Number",
          "Description": "Minimum days of advance notice required for OOO requests",
          "Category": "Approval"
        },
        {
          "Title": "MaxOOODaysPerRequest",
          "SettingValue": "30",
          "SettingType": "Number",
          "Description": "Maximum consecutive days allowed in a single OOO request",
          "Category": "Approval"
        },
        {
          "Title": "EnableDailyReminders",
          "SettingValue": "true",
          "SettingType": "Boolean",
          "Description": "Enable daily morning reminders for status updates",
          "Category": "Notification"
        },
        {
          "Title": "ReminderTime",
          "SettingValue": "08:00",
          "SettingType": "Text",
          "Description": "Time to send daily reminders (HH:MM format)",
          "Category": "Notification"
        },
        {
          "Title": "SyncToOutlookCalendar",
          "SettingValue": "true",
          "SettingType": "Boolean",
          "Description": "Automatically sync approved OOO to Outlook calendar",
          "Category": "Calendar"
        },
        {
          "Title": "WorkingDays",
          "SettingValue": "[1,2,3,4,5]",
          "SettingType": "JSON",
          "Description": "Working days of the week (0=Sunday, 6=Saturday)",
          "Category": "General"
        },
        {
          "Title": "ColorScheme",
          "SettingValue": "{\"Onsite\":\"#4CAF50\",\"Offsite\":\"#2196F3\",\"OOO-Pending\":\"#FFC107\",\"OOO-Approved\":\"#9C27B0\"}",
          "SettingType": "JSON",
          "Description": "Color codes for different status types",
          "Category": "General"
        }
      ],
      "views": [
        {
          "name": "All Settings",
          "type": "Default",
          "fields": ["Title", "SettingValue", "SettingType", "Category", "Description"]
        }
      ]
    }
  ],
  "relationships": [
    {
      "from": "ApprovalHistory",
      "to": "StaffSchedule",
      "type": "Lookup",
      "field": "RequestID",
      "description": "Links approval history to original schedule requests"
    },
    {
      "from": "StaffSchedule",
      "to": "UserProfiles",
      "type": "Reference",
      "field": "EmployeeName",
      "description": "Employee information and manager relationship"
    }
  ],
  "permissions": {
    "StaffSchedule": {
      "AllStaff": {
        "create": true,
        "read": "Own items only",
        "update": "Own items only (if Status != 'OOO-Approved')",
        "delete": false
      },
      "Managers": {
        "create": true,
        "read": true,
        "update": true,
        "delete": false
      }
    },
    "ApprovalHistory": {
      "AllStaff": {
        "create": false,
        "read": "Own items only",
        "update": false,
        "delete": false
      },
      "Managers": {
        "create": false,
        "read": true,
        "update": false,
        "delete": false
      }
    },
    "UserProfiles": {
      "AllStaff": {
        "create": false,
        "read": true,
        "update": false,
        "delete": false
      },
      "Managers": {
        "create": true,
        "read": true,
        "update": true,
        "delete": false
      }
    },
    "SystemSettings": {
      "AllStaff": {
        "create": false,
        "read": true,
        "update": false,
        "delete": false
      },
      "Managers": {
        "create": false,
        "read": true,
        "update": "Only if IsEditable = true",
        "delete": false
      }
    }
  }
}
